{
  "name": "forma-lab",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "FORMA LAB 5.0 — applicazione personale di allenamento (PWA per iPhone)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && vite build",
    "build:preview": "vite build --mode preview && node scripts/make-preview.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify:videos": "vite-node scripts/verify-videos.ts",
    "icons": "node scripts/make-icons.mjs",
    "totp:new": "node scripts/totp-setup.mjs",
    "deploy": "npm run build && npx wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
